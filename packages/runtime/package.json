{
  "name": "docsfab",
  "version": "0.0.1",
  "description": "DocsFab — a Pi-based documentation workflow agent harness.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "docsfab": "./bin/docsfab.mjs"
  },
  "exports": {
    "./roadmap": "./dist/roadmap/index.js",
    "./lineage": "./dist/lineage/index.js",
    "./inputs": "./dist/inputs/index.js",
    "./canon": "./dist/canon/index.js",
    "./publication": "./dist/publication/index.js",
    "./review-delivery": "./dist/review-delivery/public.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "dist/knowledge-provider/src/*.mjs",
    "dist/knowledge-provider/src/**/*.mjs",
    "!dist/acceptance-cli.js",
    "!dist/acceptance-export-doctor.js",
    "!dist/acceptance-judge.js",
    "!dist/campaign-judge-cli.js",
    "!dist/campaign-judge.js",
    "!dist/scorecard-cli.js",
    "!dist/scorecard-render.js",
    "!dist/scorecard.js",
    "!dist/delivery/acceptance-cli.js",
    "!dist/delivery/acceptance-chain.js",
    "!dist/delivery/acceptance-manifest.js",
    "!dist/delivery/acceptance.js",
    "!dist/delivery/acceptance-worker.js",
    "!dist/delivery/index.js",
    "!dist/quality-evaluation/corpus-cli.js",
    "!dist/quality-evaluation/documentation-navigation.js",
    "!dist/quality-evaluation/maturity-cascade-cli.js",
    "!dist/quality-evaluation/maturity-cascade-files.js",
    "!dist/quality-evaluation/maturity-cascade.js",
    "bin/",
    "governed-assets/",
    "!governed-assets/model-comparison/",
    "workflows/",
    "skill-crate/",
    "quality/",
    "quality-pack/",
    "model-compositions/",
    "!model-compositions/sources/",
    "docs/get-started/installation-reference.md",
    "LICENSE",
    "LICENSE-CC-BY-4.0",
    "NOTICE",
    "npm-shrinkwrap.json",
    "README.md",
    "SECURITY.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NVIDIA-AI-Blueprints/docsfab.git"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepack": "node scripts/build-package.mjs",
    "acceptance": "node --import tsx src/acceptance-cli.ts",
    "acceptance:catalog": "DOCSFAB_RUN_CATALOG_ACCEPTANCE=1 vitest run test/model-catalog-acceptance.test.ts test/nvidia-inference-catalog.test.ts test/inference-hub-metadata.test.ts test/inference-hub-metadata-live.test.ts",
    "acceptance:delivery": "node --import tsx src/delivery/acceptance-cli.ts",
    "judge:campaign": "node --import tsx src/campaign-judge-cli.ts",
    "scorecard": "node --import tsx src/scorecard-cli.ts",
    "doc-improvement": "node --import tsx src/doc-improvement-cli.ts",
    "evaluate:corpus": "node --import tsx src/quality-evaluation/corpus-cli.ts",
    "evaluate:maturity-cascade": "node --import tsx src/quality-evaluation/maturity-cascade-cli.ts",
    "dev": "tsx src/cli.ts",
    "start": "node bin/docsfab.mjs",
    "test": "vitest run --exclude '**/.docsfab/**'",
    "test:coverage": "vitest run --coverage --exclude '**/.docsfab/**'",
    "test:coverage:baseline": "DOCSFAB_COVERAGE_BASELINE=1 vitest run --coverage --exclude '**/.docsfab/**'",
    "test:changed": "node scripts/vitest-changed.mjs",
    "test:shuffle": "vitest run --sequence.shuffle --exclude '**/.docsfab/**'",
    "test:ci": "vitest run",
    "test:ci:fast": "node scripts/vitest-ci.mjs fast",
    "test:ci:isolation": "node scripts/vitest-ci.mjs isolation",
    "test:ci:isolation:delivery": "node scripts/vitest-ci.mjs isolation:delivery",
    "test:ci:isolation:profile": "node scripts/vitest-ci.mjs isolation:profile",
    "test:ci:isolation:docs": "node scripts/vitest-ci.mjs isolation:docs",
    "test:ci:smoke": "node scripts/vitest-ci.mjs smoke",
    "test:e2e:live-agent": "node scripts/live-agent-session-e2e.mjs",
    "test:wsl2": "node scripts/wsl2-qualification.mjs",
    "ci:env-check": "node scripts/ci-env-check.mjs",
    "bwrap:probe": "node scripts/bwrap-behavior-probe.mjs",
    "smoke:judge": "vitest run test/semantic-evaluation.test.ts",
    "smoke:self-scan": "DOCSFAB_RUN_SELF_SCAN=1 vitest run --exclude '**/.docsfab/**' test/runner.test.ts",
    "typecheck": "node scripts/ensure-derived.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.review-delivery-plan.test.json --noEmit",
    "typecheck:tests": "node scripts/ensure-derived.mjs && tsc -p tsconfig.test.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "validate:pr": "npm run typecheck && npm run test:changed",
    "security:dependencies": "node scripts/check-dependency-exceptions.mjs",
    "lint:exception-hygiene": "node scripts/lint-exception-hygiene.mjs",
    "security:contract-dialects": "node scripts/check-contract-dialect-islands.mjs",
    "check:presentation-policy": "node scripts/check-presentation-policy-boundaries.mjs",
    "verify:package": "node scripts/verify-packed-cli.mjs",
    "acceptance:clean-install": "node scripts/clean-install-acceptance.mjs",
    "acceptance:review-locator-installed": "node scripts/review-locator-installed-acceptance.mjs",
    "acceptance:package-url": "node scripts/package-url-acceptance.mjs",
    "dogfood:foundation-to-patch": "node scripts/foundation-to-patch-dogfood.mjs",
    "security:verify-threat-model-reviews": "node --import tsx src/security/threat-model-review-cli.ts",
    "check": "npm run check:pins && npm run check:static && npm test",
    "check:static": "npm run format:check && npm run lint && npm run security:contract-dialects && npm run check:presentation-policy && npm run security:dependencies && npm run check:soft-deps && npm run check:workflow-boundaries && npm run lint:exception-hygiene && npm run check:ci-heavy-manifest && npm run check:test-titles && npm run check:limits && npm run check:env-admission && npm run check:model-output && npm run check:request-wording && npm run check:credential-senders && npm run typecheck",
    "check:pins": "node scripts/generate-derived.mjs --machine --check",
    "check:reproducible": "node scripts/check-derived-reproducible.mjs",
    "check:kit": "npm run check:model-comparison-kit",
    "check:ci-heavy-manifest": "node scripts/check-ci-heavy-manifest.mjs",
    "check:soft-deps": "node scripts/check-soft-deps.mjs",
    "check:workflow-boundaries": "node scripts/check-workflow-boundaries.mjs",
    "check:skill-crate": "node scripts/generate-catalog-crate.mjs --check",
    "generate:skill-crate": "node scripts/generate-catalog-crate.mjs",
    "check:quality-pack": "node scripts/generate-quality-pack.mjs --check",
    "check:model-comparison-kit": "node scripts/generate-model-comparison-kit.mjs --check",
    "check:model-compositions": "node --import tsx scripts/check-model-compositions.mjs",
    "check:composition-digests": "node --import tsx scripts/verify-composition-digests.mts",
    "generate:quality-pack": "node scripts/generate-quality-pack.mjs",
    "generate:model-comparison-kit": "node scripts/generate-model-comparison-kit.mjs",
    "seal:model-matrix-corpus": "node --import tsx scripts/model-matrix/seal-corpus.mjs",
    "generate:pins": "node scripts/generate-derived.mjs --machine",
    "generate:derived": "node scripts/generate-derived.mjs",
    "check:derived": "node scripts/generate-derived.mjs --check",
    "derived:preflight": "node scripts/derived-preflight.mjs",
    "generate:derived-ci": "node ../../.gitlab/ci/generate-runtime-derived-ci.mjs",
    "check:derived-ci": "node ../../.gitlab/ci/generate-runtime-derived-ci.mjs --check",
    "test:generate-derived": "node --test scripts/generate-derived.test.mjs scripts/check-limits.test.mjs scripts/docs-limits-table.test.mjs scripts/check-env-admission.test.mjs scripts/check-model-output.test.mjs",
    "check:test-titles": "node scripts/check-test-titles.mjs",
    "check:request-wording": "node scripts/check-request-wording.mjs --check",
    "check:credential-senders": "node scripts/check-credential-senders.mjs --check",
    "check:limits": "node scripts/check-limits.mjs --check --committed-only --gate",
    "check:env-admission": "node scripts/check-env-admission.mjs --check --committed-only",
    "check:model-output": "node scripts/check-model-output.mjs --check --gate --committed-only",
    "generate:model-output": "node scripts/check-model-output.mjs",
    "generate:limits": "node scripts/check-limits.mjs",
    "generate:env-admission": "node scripts/check-env-admission.mjs",
    "preflight": "node scripts/docsfab-preflight.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "fast-xml-parser": "5.11.1",
    "pdfjs-dist": "6.3.289",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^24.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "lefthook": "2.1.10",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  }
}
