# DocsFab runtime host profile. Keep secrets out of this repository.
# Operator sequence: docs/get-started/installation.md
#
# Preferred layout (new installs): split host config under DOCSFAB_CONFIG_ROOT:
#   host.yaml, secrets.env, and profiles/*.yaml
# See packages/runtime/config/ for shareable examples. Run `docsfab setup` to
# materialize the split layout, or `docsfab setup --migrate` from this file.
#
# Legacy monolithic layout: copy this file to DOCSFAB_CONFIG_ROOT/.env
#
# DocsFab has no default model, and neither this file nor `docsfab setup`
# chooses one for you. `docsfab setup` does not read this file: it needs a
# provider, model, or `--profile` choice. `docsfab profile seed` does not read
# it either: it needs `--preset <id>`. In a copy of this legacy monolithic
# template, set MODEL_PROVIDER, MODEL_BASE_URL, and MODEL_ID to your model's
# route, as in the examples under "Model profile choices" below; until you do,
# DocsFab stops and lists the missing fields. GPT-5.x selections are retired
# (#1512); a profile naming `switchyard/openai/gpt-5.6-sol` is refused with
# `composition-retired`.

# MODEL_PROVIDER=<route id, for example openai-api>
# MODEL_BASE_URL=<that route's HTTPS base URL>
# MODEL_ID=<model id offered by that route>
MODEL_API_FORMAT=chat_completions
MODEL_API_KEY=
# The explicit NVIDIA API Catalog composition reads only this source.
# MODEL_API_KEY, NVIDIA_API_KEY, and NGC_API_KEY are not aliases for it.
DOCSFAB_NVIDIA_API_KEY=
# Direct-provider compositions retain their own declared sources. Omitted-mode
# legacy execution continues to use MODEL_API_KEY.
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_CONTEXT_WINDOW=524288
# Optional independent provider input cap; legacy profiles default to context.
MODEL_MAX_INPUT_TOKENS=524288
MODEL_MAX_OUTPUT_TOKENS=128000
# Downstream Responses-compatible APIs require at least 16 output tokens.
MODEL_API_MIN_OUTPUT_TOKENS=16
# Reserved before each request for provider framing and safe context headroom.
MODEL_CONTEXT_RESERVE_TOKENS=1024
MODEL_REASONING=false
MODEL_INPUT_TYPES=text
MODEL_SUPPORTS_DEVELOPER_ROLE=false
MODEL_SUPPORTS_REASONING_EFFORT=false
MODEL_COMPATIBLE_API_FORMATS=chat_completions
# Use "unknown" instead of zero when pricing has not been verified.
MODEL_INPUT_COST_PER_MILLION=unknown
MODEL_OUTPUT_COST_PER_MILLION=unknown
MODEL_CACHE_READ_COST_PER_MILLION=unknown
MODEL_CACHE_WRITE_COST_PER_MILLION=unknown
# Keep these unknown until an operator approves a source and dates. When the
# profile uniquely matches an installed composition, that match supplies the
# window instead.
MODEL_PROFILE_APPROVED_SOURCE=unknown
MODEL_PROFILE_EFFECTIVE_DATE=unknown
MODEL_PROFILE_REVIEW_AFTER=unknown

# --- Model profile choices (set MODEL_PROVIDER, MODEL_BASE_URL, MODEL_ID) ---
#
# Explicit NVIDIA API Catalog executable compositions. Select one with
# `--composition <id>` from `docsfab composition list`, for
# example nvidia-nemotron-3-super-120b-a12b-pi. The former example,
# nvidia-llama-3.3-nemotron-super-49b-v1.5-pi, is retired: NVIDIA
# ended that model's life on 2026-08-26 and the route now answers HTTP 410, so
# the runtime refuses it with `composition-retired`.
# MODEL_PROVIDER=nvidia-api-catalog
# MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_ID=nvidia/nemotron-3-super-120b-a12b
# The 120B lane's sealed limit is 524288 (route-proven 2026-09-11 at 532k
# tokens); the effective limit is min(these, candidate, composition, ceiling).
# MODEL_CONTEXT_WINDOW=524288
# MODEL_MAX_INPUT_TOKENS=524288
# MODEL_MAX_OUTPUT_TOKENS=8192
# DOCSFAB_NVIDIA_API_KEY=<host secret; keep MODEL_API_KEY empty>
#
# Internal NVIDIA hosts: GPT-6 Sol on the internal Inference Hub route is the
# composition `nvidia-inference-gpt-6-sol-pi`. Select it explicitly
# with `docsfab setup --profile nvidia-inference-gpt-6-sol-pi`, which
# writes the composition id instead of this field block, or with
# `docsfab profile seed --preset azure/openai/gpt-6-sol` on a legacy host, or
# per run with
# `--composition nvidia-inference-gpt-6-sol-pi`.
# Its route id is nvidia-inference-api and its model id azure/openai/gpt-6-sol.
# It carries NO installed request policy (probe verdict harness-compatible).
#
# Secondary Inference Hub compositions: Anthropic Claude 5 via Bedrock through
# the hub (the sanctioned programmatic Claude path). Select with
# `--composition nvidia-inference-claude-sonnet-5-pi` or
# `--composition nvidia-inference-claude-opus-5-pi`. Sonnet 5 has
# known workflow gaps (provider stops, output truncation at its sealed limit).
# These records carry NO installed request policy: the models are not
# reasoning-split, so no reasoning directive or chat-template kwarg is needed
# and none is sent. Same MODEL_API_KEY. This and the Inference Hub entries
# below list only MODEL_ID and its limits: a field block for any of them also
# needs MODEL_PROVIDER=nvidia-inference-api and that route's MODEL_BASE_URL.
# MODEL_ID=aws/anthropic/bedrock-claude-sonnet-5
# MODEL_ID=aws/anthropic/bedrock-claude-opus-5
# MODEL_REASONING=false
# MODEL_CONTEXT_WINDOW=524288
# MODEL_MAX_INPUT_TOKENS=524288
# MODEL_MAX_OUTPUT_TOKENS=8192
#
# NVIDIA audit with strong tool discipline (readiness still flaky):
# MODEL_ID=nvidia/nvidia/nemotron-3-super-v3
# Uncommented, the next line is your setting and turns reasoning on: requests
# drop the preset's thinking-off request policy, with a warning, and the model
# can spend its whole output allowance reasoning. Use false to keep the policy.
# MODEL_REASONING=true
# MODEL_CONTEXT_WINDOW=128000
# MODEL_MAX_INPUT_TOKENS=128000
# MODEL_MAX_OUTPUT_TOKENS=8192
#
# Moonshot alternative (2/2 pass in the Aug 2026 eval; ~3x token cost):
# MODEL_ID=nvidia/moonshotai/kimi-k2.6
# MODEL_REASONING=false
# MODEL_CONTEXT_WINDOW=128000
# MODEL_MAX_INPUT_TOKENS=128000
# MODEL_MAX_OUTPUT_TOKENS=8192
#
# Not recommended for governed campaigns (0/2 or 1/2 in Aug 2026 eval):
# nvidia/nvidia/nemotron-3.5-lightning, nvidia/moonshotai/kimi-k3-high-preview

# --- Direct-provider executable composition settings ---
# The direct OpenAI GPT-5.6 Sol composition is retired
# (superseded-by-operator-decision, #1512).
#
# Direct Anthropic through the installed Anthropic Messages adapter:
# MODEL_PROVIDER=anthropic-api
# MODEL_BASE_URL=https://api.anthropic.com/v1
# MODEL_ID=claude-opus-4-7
# MODEL_API_FORMAT=messages
# MODEL_COMPATIBLE_API_FORMATS=messages
# ANTHROPIC_API_KEY=<host secret; keep MODEL_API_KEY empty>

# Optional, explicit NVIDIA Inference API catalog plus authenticated Inference
# Hub Metadata inspection only (`profile inspect --catalog`). Do not configure
# these variables for direct OpenAI, direct Anthropic, Codex, Claude Code, NIM,
# or embedding bindings.
# The Metadata endpoint is host-owned and never inferred from provider responses.
# Use a distinct ihub_api_ credential; MODEL_API_KEY/JUDGE_API_KEY are rejected here.
# Ordinary doctor and workflows never read these Metadata settings or call a catalog.
# NVIDIA Inference Hub Metadata service values (search mode sends the label as
# `search`; the key is sent as `x-api-key`; leave LABEL_PARAMETER empty):
# INFERENCE_HUB_METADATA_ORIGIN=https://inference-backend.nvidia.com
# INFERENCE_HUB_METADATA_PATH=/api/v1/models
# INFERENCE_HUB_METADATA_MODE=search
# MODEL_INFERENCE_HUB_METADATA_LABEL=azure/openai/gpt-6-sol
INFERENCE_HUB_METADATA_ORIGIN=
INFERENCE_HUB_METADATA_PATH=
INFERENCE_HUB_METADATA_MODE=
INFERENCE_HUB_METADATA_LABEL_PARAMETER=
INFERENCE_HUB_METADATA_API_KEY=
MODEL_INFERENCE_HUB_METADATA_LABEL=
JUDGE_INFERENCE_HUB_METADATA_LABEL=

# Optional semantic evaluation judge. The CLI calls it only with evaluate
# --judge; deterministic structural results remain authoritative. It has no
# default route: before setting JUDGE_ENABLED=true, set JUDGE_PROVIDER and
# JUDGE_BASE_URL. On internal NVIDIA hosts the judge route is
# nvidia-inference-api-judge, at the internal Inference Hub base URL. This is
# not a direct Anthropic Messages profile.
JUDGE_ENABLED=false
# JUDGE_PROVIDER=<judge route id>
# JUDGE_BASE_URL=<that route's HTTPS base URL>
JUDGE_MODEL_ID=aws/anthropic/bedrock-claude-opus-4-7
JUDGE_API_FORMAT=chat_completions
JUDGE_API_KEY=
JUDGE_CONTEXT_WINDOW=200000
JUDGE_MAX_INPUT_TOKENS=200000
JUDGE_MAX_OUTPUT_TOKENS=16384
JUDGE_API_MIN_OUTPUT_TOKENS=16
JUDGE_CONTEXT_RESERVE_TOKENS=4096
# A JUDGE_REASONING=true line is your setting: the judge's short replies then
# carry reasoning, which can spend their small output allowance. Keep false
# unless you want that.
JUDGE_REASONING=false
JUDGE_INPUT_TYPES=text
JUDGE_SUPPORTS_DEVELOPER_ROLE=false
JUDGE_SUPPORTS_REASONING_EFFORT=false
JUDGE_COMPATIBLE_API_FORMATS=chat_completions
JUDGE_INPUT_COST_PER_MILLION=unknown
JUDGE_OUTPUT_COST_PER_MILLION=unknown
JUDGE_CACHE_READ_COST_PER_MILLION=unknown
JUDGE_CACHE_WRITE_COST_PER_MILLION=unknown
# Keep all three "unknown" until judge metadata is independently approved.
JUDGE_PROFILE_APPROVED_SOURCE=unknown
JUDGE_PROFILE_EFFECTIVE_DATE=unknown
JUDGE_PROFILE_REVIEW_AFTER=unknown

# Optional DocsFab settings.
# Operators may set DOCSFAB_CONFIG_ROOT to an absolute directory for writable
# .env, profile, and state. Keep that config in this package; do not move
# secrets to a repo-root .env. Package-local .docsfab/runs is gitignored;
# do not commit run records.
DOCSFAB_SKILL_CRATE_DIR=./skill-crate
DOCSFAB_QUALITY_DIR=./quality
DOCSFAB_QUALITY_PACK_DIR=./quality-pack
DOCSFAB_STATE_DIR=./.docsfab/runs
# Owner-only JSON containing the host-trusted Ed25519 reviewer public-key policy.
# Private signing keys are never configured here.
DOCSFAB_IA_REVIEWER_POLICY_PATH=
# Read-only inference, plus the CREATE revision writer, which replays a
# retryable malformed reply after the host restores candidate 0. Every other
# write step uses zero automatic retries. The name is historical.
# Values are bounded to 0-3 retries and 0-30000 ms delays.
DOCSFAB_READ_ONLY_MAX_RETRIES=3
DOCSFAB_RETRY_BASE_DELAY_MS=1000
DOCSFAB_RETRY_MAX_DELAY_MS=2000
# Leave DOCSFAB_RETRYABLE_CATEGORIES unset to retry every category the runtime
# allows; set it only to narrow the list (comma-separated). A pinned list that
# omits no-progress makes `docsfab doctor` say so.
# DOCSFAB_RETRYABLE_CATEGORIES=
# Host-owned composition ceilings are clamped again by the selected candidate,
# composition, and packaged maximum. They are experiment settings, not model
# metadata or approval evidence.
# Fresh ordinary configurations use the catalog defaults. Existing operator
# environments remain explicit overrides and are not rewritten by an upgrade.
# Candidate, composition, and package ceilings can still reduce these values.
#
# Frozen comparison campaigns use their own explicit fixture envelope rather
# than this general template. The historical cross-harness corpus requires
# contextWindow/maxInputTokens 65536, maxOutputTokens 8192, provider turns 4,
# timeoutMs 300000, and maxResponseBytes 65536. Preserve those exact experiment
# settings when reproducing that corpus; they are not ordinary-run defaults.
DOCSFAB_COMPOSITION_EXECUTION_MAX_PROVIDER_TURNS=512
DOCSFAB_COMPOSITION_EXECUTION_TIMEOUT_MS=3600000
DOCSFAB_COMPOSITION_EXECUTION_MAX_RESPONSE_BYTES=4194304
# Native CLI preflight and the acknowledged cross-harness pilot never select
# executables from ambient PATH. Use canonical absolute executable paths. The
# pilot requires all three values; ordinary provider and preflight commands do
# not invoke Python merely because DOCSFAB_PYTHON_EXECUTABLE is configured.
# pilot-campaign loads this file from DOCSFAB_CONFIG_ROOT; explicit process
# environment values take precedence.
DOCSFAB_CODEX_EXECUTABLE=
DOCSFAB_CLAUDE_EXECUTABLE=
DOCSFAB_PYTHON_EXECUTABLE=
# The pilot's durable Nemotron replay registry is derived beside
# DOCSFAB_STATE_DIR. Put that owner-private state outside both the installed
# DocsFab package and the frozen target/source repository.

# The MVP acceptance command also requires matching CLI flags before egress.
DOCSFAB_ACCEPTANCE_LIVE=false
DOCSFAB_ACCEPTANCE_JUDGE=false
# Separate opt-in for the five-record, revision-bound scorecard judge.
DOCSFAB_CAMPAIGN_JUDGE=false
