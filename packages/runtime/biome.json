{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{js,mjs,cjs,ts,tsx,json,jsonc}",
      "test/**/*.{js,mjs,cjs,ts,tsx,json,jsonc}",
      "scripts/**/*.{js,mjs,cjs,ts,tsx,json,jsonc}",
      "bin/**/*.mjs",
      "package.json",
      "tsconfig.json",
      "vitest.config.ts",
      "biome.json",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.docsfab",
      "!**/*.generated.*",
      "src/config/limits.generated.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noAdjacentSpacesInRegex": "off",
        "noUselessCatch": "off",
        "noUselessEscapeInRegex": "off",
        "noUselessStringRaw": "off",
        "noUselessTernary": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "off",
        "noUnusedVariables": "off",
        "noUnreachable": "off",
        "noUnsafeFinally": "off",
        "noVoidTypeReturn": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "off",
        "useImportType": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noPrototypeBuiltins": "off",
        "noTemplateCurlyInString": "off",
        "noUselessEscapeInString": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
