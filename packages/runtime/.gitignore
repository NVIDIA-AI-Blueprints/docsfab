# fixture. Keep this one simulated .docsfab file in the governed bundle.
.cache/
ci-results/
coverage-lanes/
.env
.env.docsfab-new-*
.env.docsfab-rollback-*
.env.docsfab-apply.lock
.env.docsfab-transaction.json
.env.docsfab-recovery.claim
.DS_Store
coverage/
package-artifacts/
package-candidate/
# DurableArtifactStore test byproducts (objects/sha256/*.json). Leading slash
# anchors to this directory so it does not also match src/artifacts/.
/artifacts/
*.log
