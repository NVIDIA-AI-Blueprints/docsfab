{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsfab.invalid/schemas/assurance-system-measurement.schema.json",
  "title": "Documentation assurance-system measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "measurement_id",
    "measured_at",
    "policy_version",
    "observation_window",
    "population",
    "metrics",
    "health_decision",
    "confidence",
    "missing_measures",
    "limitations",
    "actions"
  ],
  "properties": {
    "measurement_id": {"type": "string", "minLength": 1},
    "measured_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1},
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "count", "scope"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "value", "unit", "method", "evidence", "interpretation"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "numerator": {"type": "number", "minimum": 0},
          "denominator": {"type": "number", "exclusiveMinimum": 0},
          "sample_size": {"type": "integer", "minimum": 0},
          "method": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "interpretation": {"type": "string", "minLength": 1}
        }
      }
    },
    "health_decision": {"enum": ["healthy", "at-risk", "unhealthy", "insufficient-evidence"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "missing_measures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
