node_modules/
# packages/host/scripts/ensure-typecheck-deps.mjs's transient install lock
# for this directory; removed on exit, but ignore in case a crashed process
# leaves it behind.
.docsfab-typecheck-install.lock/
dist/
# scripts/build-package.mjs staging; a killed build can leave these behind.
dist.staging-*/
dist.previous-*/
.docsfab/

