      "states": [
        "observed",
        "proposed",
        "filed",
        "selected",
        "in-progress",
        "fixed",
        "verified",
        "closed",
        "observed"
      ]
    },
    {
      "id": "blocked-and-resumed",
      "states": ["observed", "blocked", "observed", "proposed"]
