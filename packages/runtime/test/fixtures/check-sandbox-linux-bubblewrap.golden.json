{
  "launches": [
    {
      "executable": "/usr/bin/bwrap",
      "args": [
        "--die-with-parent",
        "--unshare-all",
        "--new-session",
        "--ro-bind",
        "/bin",
        "/bin",
        "--ro-bind",
        "/lib",
        "/lib",
        "--ro-bind",
        "/usr/bin",
        "/usr/bin",
